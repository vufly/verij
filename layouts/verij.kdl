layout {
    // Verij renders placeholders when starting a new host session.
    // Edit installed copy under $XDG_CONFIG_HOME/verij or ~/.config/verij.
    default_tab_template {
        children
    }

    tab name="Verij Host" {
        pane split_direction="vertical" {
            pane size="{{sidebar_width}}" name="Verij" {
                command "{{verij_bin}}"
                args "ui"
            }
            pane name="Workspace" borderless=true
        }
    }
}
