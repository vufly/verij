layout {
    // Override the global default_tab_template so zjstatus is not appended to
    // the host session tab (it belongs only in inner sessions via default.kdl).
    default_tab_template {
        children
    }

    tab name="Verij Host" {
        pane split_direction="vertical" {
            pane size="25%" name="Verij" {
                command "target/release/verij"
                args "ui"
            }
            pane name="Workspace" borderless=true
        }
    }
}
